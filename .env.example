# Copy this file to `.env` and fill in your key.
#
#     copy .env.example .env        (Windows)
#     cp   .env.example .env        (macOS / Linux)
#
# `.env` is gitignored. Never commit it, never paste a key into a source file,
# a notebook, a screenshot, or a chat message.
#
# If a key ever leaks: revoke it in Google AI Studio FIRST, then generate a new
# one. Deleting the file in a later commit does not help — git history is
# permanent, and scrapers find public keys within minutes.

# From Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Optional. Every notebook runs on Gemini unless this is set to "lightning" --
# an instructor-side fallback for when the Gemini free tier's ~6 requests/
# minute ceiling gets in the way. See llm_client.py for what carries over.
# LLM_PROVIDER=lightning
# LIGHTNING_API_KEY=your-key-here

# Optional. embedding_client.py defaults to "gemini", reusing GEMINI_API_KEY
# above -- no extra key needed. Gemini is the default because query/document
# task_type asymmetry, which Week 3 teaches, works only there.
#
# Embeddings are rate-limited: ~100 texts/minute, counted per text rather than
# per request (measured 2026-09-14), so a large corpus takes real time. Embed
# once with `python ingest.py`, which paces itself and writes to ./chroma/ --
# not from a notebook cell you will re-run.
# EMBEDDING_PROVIDER=openrouter
# OPENROUTER_API_KEY=your-key-here

# Local Neo4j, matching docker-compose.yml. Fine to leave as-is.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=modernai
